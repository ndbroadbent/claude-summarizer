<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ndbroadbent.claude-summarizer-web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_DIR__/bin/claude-summarizer</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_SUMMARIZER_PYTHON</key>
    <string>/usr/bin/python3</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-summarizer-web.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-summarizer-web.log</string>
</dict>
</plist>
